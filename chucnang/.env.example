# Sao chép thành chucnang/.env (máy local) hoặc khai báo trong Vercel → Settings → Environment Variables
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/walentykho?retryWrites=true&w=majority
# Mật khẩu ban đầu của tài khoản admin khi database còn trống (đổi ngay sau khi đăng nhập)
ADMIN_PASSWORD=
